{
  "manifest_version": 3,
  "name": "Prímový Skip Ad",
  "version": "1.2.2",
  "description": "Posune přehrávané video o nastavitelný počet sekund.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/store-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Prímový Skip Ad",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "primovy-skip-ad@zorbix.github.io",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://oneplay.cz/*",
        "https://www.oneplay.cz/*"
      ],
      "js": [
        "ad-skip.js",
        "firefox/bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
